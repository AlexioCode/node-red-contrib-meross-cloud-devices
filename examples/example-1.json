    {
        "id": "0e8f9e7af3e414c8",
        "type": "function",
        "z": "ad1ccc1303810b4d",
        "name": "temperature with metadata",
        "func": "if (msg && Object.keys(msg).length > 0) {\n    var sensorTs = msg.payload.system.time.timestamp;\n    var sensorId = \"Smart Temperature and Humidity Sensor\";\n    var location = \"Kitchen\";\n    var value = msg.payload.digest.hub.subdevice[3].tempHumi.temp / 100;\n    var unit = \"Degrees Celsius\";\n\n    msg.payload = {};\n    msg.payload.sensorTs = sensorTs;\n    msg.payload.sensorId = sensorId;\n    msg.payload.location = location;\n    msg.payload.value = value;\n    msg.payload.unit = unit;\n}\nelse {\n    msg.payload = {\n        \"error\": \"Failed to receive sensor data\"\n    }\n}\n\nreturn msg;",
        "outputs": 1,
